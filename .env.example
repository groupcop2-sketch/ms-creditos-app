# ========================================================
# CONFIGURACIÓN GENERAL DEL MICROSERVICIO DE CRÉDITOS
# ========================================================
PORT=3001
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://creditos-app-psi.vercel.app
JWT_SECRET=change-me-in-local-dev
JWT_EXPIRES_IN=8h
APP_PUBLIC_URL=http://localhost:5173

# Base de datos Supabase PostgreSQL
PGHOST=aws-0-ca-central-1.pooler.supabase.com
PGPORT=6543
PGUSER=postgres.your-project-id
PGPASSWORD=your-db-password
PGDATABASE=postgres

# ========================================================
# INTEGRACIÓN DOCUSIGN eSignature API (v2.1)
# ========================================================
# DOCUSIGN_SIMULATION_MODE:
# - 'true': Permite enviar documentos, probar el visor de firma, simular aprobaciones/rechazos
#   y verificar la máquina de estados sin consumir saldo ni requerir llaves reales.
# - 'false': Utiliza la API real de DocuSign eSignature REST API.
DOCUSIGN_SIMULATION_MODE=true

# DocuSign Account ID (GUID de la cuenta en DocuSign Admin / Developer Center)
DOCUSIGN_ACCOUNT_ID=

# Integration Key / Client ID de la aplicación registrada en DocuSign eSignature
DOCUSIGN_CLIENT_ID=

# Impersonated User GUID (ID de usuario que otorga consentimiento para JWT Grant)
DOCUSIGN_USER_ID=

# Servidor de autenticación OAuth:
# - Pruebas / Sandbox: account-d.docusign.com
# - Producción: account.docusign.com
DOCUSIGN_AUTH_SERVER=account-d.docusign.com

# URL Base de la API REST:
# - Pruebas / Sandbox: https://demo.docusign.net/restapi
# - Producción: https://na1.docusign.net/restapi (o el cluster asignado a tu cuenta)
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# Llave privada RSA en formato PEM (para autenticación automática JWT Grant)
# Debe incluir las líneas -----BEGIN RSA PRIVATE KEY----- y -----END RSA PRIVATE KEY-----
DOCUSIGN_RSA_PRIVATE_KEY=

# Token de acceso Bearer opcional (para pruebas rápidas sin flujo JWT)
DOCUSIGN_ACCESS_TOKEN=

# Clave HMAC secreta configurada en DocuSign Connect para validar webhooks
DOCUSIGN_WEBHOOK_SECRET=docusign-secret-hmac-key
